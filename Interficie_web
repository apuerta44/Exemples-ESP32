// ===================================
// FUNCIONS DEL SERVIDOR WEB
// ===================================

// Mostrar pagina principal
void handleRoot() {

  server.send(200, "text/html; charset=utf-8", HTML);

}

// Encendre LED
void handleOn() {

  ledBlink = false;
  ledState = true;

  digitalWrite(LED_PIN, HIGH);

  server.send(200, "text/plain; charset=utf-8",
              "Estat: LED encès");

}

// Apagar LED
void handleOff() {

  ledBlink = false;
  ledState = false;

  digitalWrite(LED_PIN, LOW);

  server.send(200, "text/plain; charset=utf-8",
              "Estat: LED apagat");

}

// Fer parpellejar LED
void handleBlink() {

  ledBlink = true;
  previousMillis = millis();

  server.send(200, "text/plain; charset=utf-8",
              "Estat: LED parpellejant");

}

// ===================================
// SETUP
// ===================================

void setup() {

  Serial.begin(115200);

  pinMode(LED_PIN, OUTPUT);

  digitalWrite(LED_PIN, LOW);

  // Connexio Wi-Fi

  Serial.println();
  Serial.println("Iniciant connexio Wi-Fi...");

  WiFi.mode(WIFI_STA);

  WiFi.begin(ssid, password);

  unsigned long inici = millis();

  while (WiFi.status() != WL_CONNECTED &&
         millis() - inici < 20000) {

    delay(500);

    Serial.print(".");

  }

  // Comprovar connexio

  if (WiFi.status() == WL_CONNECTED) {

    Serial.println();
    Serial.println("Wi-Fi connectada!");

    Serial.print("Adreca IP: ");
    Serial.println(WiFi.localIP());

    // Configurar rutes del servidor

    server.on("/", handleRoot);

    server.on("/on", handleOn);

    server.on("/off", handleOff);

    server.on("/blink", handleBlink);

    // Iniciar servidor

    server.begin();

    Serial.println("Servidor web iniciat al port 80.");

    Serial.print("Obre: http://");
    Serial.println(WiFi.localIP());

  } else {

    Serial.println();
    Serial.println("ERROR: No s'ha pogut connectar a la Wi-Fi.");

    Serial.println("Revisa el nom i la contrasenya.");

  }

}

// ===================================
// LOOP
// ===================================

void loop() {

  // Atendre peticions web si hi ha Wi-Fi

  if (WiFi.status() == WL_CONNECTED) {

    server.handleClient();

  }

  // Control del parpelleig

  if (ledBlink &&
      millis() - previousMillis >= blinkInterval) {

    previousMillis = millis();

    ledState = !ledState;

    digitalWrite(LED_PIN, ledState ? HIGH : LOW);

  }

}
