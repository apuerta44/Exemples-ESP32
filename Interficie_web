
#include <WiFi.h>
#include <WebServer.h>

// ===================================
// CONFIGURACIO WIFI
// ===================================

const char* ssid = "Wifi-arturo";
const char* password = "12345678";

// ===================================
// CONFIGURACIO LED I SERVIDOR
// ===================================

const int LED_PIN = 32;

WebServer server(80);

bool ledBlink = false;
bool ledState = false;

unsigned long previousMillis = 0;
const unsigned long blinkInterval = 500;

// ===================================
// PAGINA WEB
// ===================================

const char HTML[] PROGMEM = R"rawliteral(
